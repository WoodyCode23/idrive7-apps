{
  "id": "woodr_warmhud",
  "title": "Warm-Up HUD",
  "description": "Oil warm-up state on the head-up display: temperature, readiness and a safe-rev ceiling while the engine is cold",
  "version": "0.1.1",
  "vendor": "custom",
  "loggingId": "OAA6",
  "iconGlyph": "warmup",
  "mguHmi": ["ID7"],
  "signals": {
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineTemperature": "rs",
      "statusEngineSpeed2": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Warm-Up HUD",
      "buttons": [
        ["BTN_ACTION", "HUD on/off"],
        ["BTN_SETTINGS", "Settings"]
      ]
    }
  ],
  "settings": [
    {"key": "hud", "label": "Show on head-up display", "type": "bool", "default": true},
    {"key": "readyAt", "label": "Oil ready above", "type": "number", "unit": "C", "default": 90, "steps": [80, 85, 90, 95, 100]},
    {"key": "hideWhenReady", "label": "Hide once ready", "type": "choice", "default": "30",
     "options": [["0", "Keep showing"], ["10", "After 10 s"], ["30", "After 30 s"], ["60", "After 60 s"]]},
    {"key": "tempUnit", "label": "Temperature unit", "type": "choice", "default": "c",
     "options": [["c", "Celsius"], ["f", "Fahrenheit"]]},
    {"key": "posY", "label": "Vertical position", "type": "number", "unit": "px", "default": 140, "steps": [100, 120, 140, 160, 180, 200]},
    {"key": "scale", "label": "Size", "type": "choice", "default": "100",
     "options": [["80", "Small"], ["100", "Standard"], ["120", "Large"]]}
  ]
}
